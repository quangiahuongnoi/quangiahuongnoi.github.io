# Discord application
DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_application_client_id
DISCORD_GUILD_ID=your_server_id

# Channel that receives live notifications
DISCORD_LIVE_CHANNEL_ID=your_live_channel_id

# Optional role to mention. Leave empty to mention nobody.
DISCORD_LIVE_ROLE_ID=

# Website/API
WEBSITE_URL=https://quangiahuongnoi.github.io/
WEBHOOK_PORT=8787
WEBHOOK_SECRET=replace_with_a_long_random_secret

# Default live data
STREAMER_NAME=Quản gia hướng nội
DEFAULT_PLATFORM=TikTok
